# Copy this file to .env before running Docker Compose.
POSTGRES_DB=bizforce
POSTGRES_USER=bizforce
# Use a long URL-safe value because it is embedded in DATABASE_URL.
POSTGRES_PASSWORD=replace-with-a-long-random-password

# Both signing secrets must contain at least 32 characters.
JWT_SECRET=replace-with-at-least-32-random-characters
PORTAL_JWT_SECRET=replace-with-at-least-32-random-characters

# Public URL allowed to access the API through the frontend proxy.
APP_ORIGIN=http://localhost:3001
FRONTEND_PORT=3001

# Optional Google OAuth client identifier.
GOOGLE_CLIENT_ID=

