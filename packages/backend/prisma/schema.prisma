generator client {
  provider      = "prisma-client-js"
  output        = "../src/generated/prisma-client"
  binaryTargets = ["native", "debian-openssl-1.1.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                     String    @id @default(uuid())
  userName               String    @unique @db.VarChar(100)
  email                  String    @unique @db.VarChar(100)
  firstName              String    @db.VarChar(100)
  lastName               String    @db.VarChar(100)
  password               String    @db.VarChar(255)
  phone                  String?   @db.VarChar(30)
  mobile                 String?   @db.VarChar(30)
  title                  String?   @db.VarChar(100)
  department             String?   @db.VarChar(100)
  addressStreet          String?   @db.VarChar(200)
  addressCity            String?   @db.VarChar(100)
  addressState           String?   @db.VarChar(100)
  addressCountry         String?   @db.VarChar(100)
  addressPostalCode      String?   @db.VarChar(30)
  timezone               String    @default("Asia/Karachi") @db.VarChar(100)
  language               String    @default("en_us") @db.VarChar(10)
  avatar                 String?   @db.VarChar(500)
  pbxExtension           String?   @db.VarChar(50)
  isActive               Boolean   @default(true)
  isAdmin                Boolean   @default(false)
  isAgent                Boolean   @default(false)
  lastLogin              DateTime?
  lastActiveAt           DateTime?
  resetToken             String?   @unique @db.VarChar(255)
  resetTokenExpires      DateTime?
  twoFactorSecret        String?   @db.VarChar(500)
  twoFactorEnabled       Boolean   @default(false)
  hasCompletedOnboarding Boolean   @default(false)
  hasCompletedQuickStart Boolean   @default(false)
  failedLoginAttempts    Int       @default(0)
  lockedUntil            DateTime?
  dateFormat             String?   @db.VarChar(20)
  hourFormat             String?   @db.VarChar(10)
  startOfWeek            String?   @db.VarChar(10)
  defaultModule          String?   @db.VarChar(100)
  currencyCode           String?   @db.VarChar(3)
  sidebarColor           String?   @default("vtiger") @db.VarChar(30)
  dashboardEnabled       Boolean   @default(true)
  dashboardConfig        Json?
  favoriteModules        Json?
  tokenVersion           Int       @default(0)
  roleId                 String?
  companyId              String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  role                         Role?                   @relation(fields: [roleId], references: [id])
  company                      Company?                @relation(fields: [companyId], references: [id])
  profile                      UserProfile?
  groups                       UserGroupMember[]
  loginLogs                    LoginLog[]
  notifications                Notification[]
  potentialStageHistoryChanged PotentialStageHistory[] @relation("PotentialStageHistoryChangedBy")
  chatParticipants             ChatParticipant[]
  chatMessages                 ChatMessage[]
  chatConversationsCreated     ChatConversation[]      @relation("ChatCreatedBy")
}

model Role {
  id          String   @id @default(uuid())
  name        String   @db.VarChar(100)
  description String?  @db.VarChar(500)
  parentId    String?
  companyId   String?
  isPublic    Boolean  @default(true)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  parent      Role?            @relation("RoleHierarchy", fields: [parentId], references: [id])
  children    Role[]           @relation("RoleHierarchy")
  users       User[]
  permissions RolePermission[]

  @@unique([name, companyId])
}

model RolePermission {
  id         String   @id @default(uuid())
  roleId     String
  moduleName String   @db.VarChar(100)
  view       Boolean  @default(true)
  create     Boolean  @default(false)
  edit       Boolean  @default(false)
  delete     Boolean  @default(false)
  import     Boolean  @default(false)
  export     Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, moduleName])
}

model UserGroup {
  id          String   @id @default(uuid())
  name        String   @db.VarChar(100)
  description String?  @db.VarChar(500)
  companyId   String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members UserGroupMember[]
}

model UserGroupMember {
  id        String   @id @default(uuid())
  groupId   String
  userId    String
  createdAt DateTime @default(now())

  group UserGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
}

model UserProfile {
  id           String   @id @default(uuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id])
  isSuperAdmin Boolean  @default(false)
  permissions  Json     @default("{}")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Module {
  id        String   @id @default(uuid())
  name      String   @unique @db.VarChar(100)
  label     String   @db.VarChar(100)
  parent    String?  @db.VarChar(100)
  sequence  Int      @default(0)
  isEntity  Boolean  @default(true)
  isActive  Boolean  @default(true)
  icon      String?  @db.VarChar(50)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customViews CustomView[]
}

model Currency {
  id        String   @id @default(uuid())
  name      String   @db.VarChar(100)
  code      String   @db.VarChar(3)
  symbol    String   @db.VarChar(10)
  rate      Decimal  @default(1) @db.Decimal(10, 5)
  isDefault Boolean  @default(false)
  isActive  Boolean  @default(false)
  companyId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, code])
  @@index([companyId])
}

model CustomView {
  id         String   @id @default(uuid())
  moduleId   String
  module     Module   @relation(fields: [moduleId], references: [id])
  name       String   @db.VarChar(100)
  isDefault  Boolean  @default(false)
  isPublic   Boolean  @default(false)
  userId     String?
  columns    Json     @default("[]")
  conditions Json     @default("[]")
  orderBy    Json?
  companyId  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([companyId])
}

model Account {
  id                 String   @id @default(uuid())
  accountNo          String?  @unique @db.VarChar(100)
  accountName        String   @db.VarChar(200)
  parentId           String?  @db.VarChar(100)
  website            String?  @db.VarChar(200)
  phone              String?  @db.VarChar(30)
  otherPhone         String?  @db.VarChar(30)
  fax                String?  @db.VarChar(30)
  email              String?  @db.VarChar(100)
  email2             String?  @db.VarChar(100)
  emailOptOut        Boolean  @default(false)
  notifyOwner        Boolean  @default(false)
  employees          Int?
  annualRevenue      Decimal? @db.Decimal(16, 2)
  industry           String?  @db.VarChar(100)
  accountType        String?  @db.VarChar(100)
  ownership          String?  @db.VarChar(100)
  rating             String?  @db.VarChar(10)
  sicCode            String?  @db.VarChar(30)
  tickerSymbol       String?  @db.VarChar(30)
  glAccount          String?  @db.VarChar(200)
  billingStreet      String?  @db.VarChar(200)
  billingCity        String?  @db.VarChar(100)
  billingState       String?  @db.VarChar(100)
  billingCountry     String?  @db.VarChar(100)
  billingPostalCode  String?  @db.VarChar(30)
  billingPoBox       String?  @db.VarChar(50)
  shippingStreet     String?  @db.VarChar(200)
  shippingCity       String?  @db.VarChar(100)
  shippingState      String?  @db.VarChar(100)
  shippingCountry    String?  @db.VarChar(100)
  shippingPostalCode String?  @db.VarChar(30)
  shippingPoBox      String?  @db.VarChar(50)
  description        String?  @db.Text
  companyId          String?
  isActive           Boolean  @default(true)
  createdBy          String?
  assignedTo         String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model Contact {
  id                  String    @id @default(uuid())
  contactNo           String?   @unique @db.VarChar(100)
  salutation          String?   @db.VarChar(50)
  firstName           String    @db.VarChar(100)
  lastName            String    @db.VarChar(100)
  title               String?   @db.VarChar(100)
  department          String?   @db.VarChar(100)
  email               String?   @db.VarChar(100)
  secondaryEmail      String?   @db.VarChar(100)
  phone               String?   @db.VarChar(30)
  mobile              String?   @db.VarChar(30)
  homePhone           String?   @db.VarChar(30)
  otherPhone          String?   @db.VarChar(30)
  fax                 String?   @db.VarChar(30)
  assistant           String?   @db.VarChar(100)
  assistantPhone      String?   @db.VarChar(30)
  dob                 DateTime?
  reportsTo           String?
  leadSource          String?   @db.VarChar(100)
  contactType         String?   @db.VarChar(100)
  contactStatus       String?   @db.VarChar(100)
  emailOptIn          String?   @db.VarChar(100)
  smsOptIn            String?   @db.VarChar(100)
  preferredLanguage   String?   @db.VarChar(50)
  platform            String?   @db.VarChar(100)
  adGroup             String?   @db.VarChar(150)
  timeZone            String?   @db.VarChar(100)
  primaryTwitter      String?   @db.VarChar(200)
  primaryLinkedIn     String?   @db.VarChar(300)
  linkedInFollowers   Int?
  primaryFacebook     String?   @db.VarChar(300)
  facebookFollowers   Int?
  doNotCall           Boolean   @default(false)
  emailOptOut         Boolean   @default(false)
  notifyOwner         Boolean   @default(false)
  portal              Boolean   @default(false)
  image               String?   @db.VarChar(300)
  supportStartDate    DateTime?
  supportEndDate      DateTime?
  isConvertedFromLead Boolean   @default(false)
  googleContactId     String?   @db.VarChar(300)
  assignedTo          String?
  companyId           String?
  isActive            Boolean   @default(true)
  description         String?   @db.Text
  mailingStreet       String?   @db.VarChar(200)
  mailingCity         String?   @db.VarChar(100)
  mailingState        String?   @db.VarChar(100)
  mailingCountry      String?   @db.VarChar(100)
  mailingPostalCode   String?   @db.VarChar(30)
  mailingPoBox        String?   @db.VarChar(50)
  otherStreet         String?   @db.VarChar(200)
  otherCity           String?   @db.VarChar(100)
  otherState          String?   @db.VarChar(100)
  otherCountry        String?   @db.VarChar(100)
  otherPostalCode     String?   @db.VarChar(30)
  otherPoBox          String?   @db.VarChar(50)
  accountId           String?
  createdBy           String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
}

model Lead {
  id                   String   @id @default(uuid())
  leadNo               String?  @unique @db.VarChar(100)
  salutation           String?  @db.VarChar(50)
  firstName            String   @db.VarChar(100)
  lastName             String   @db.VarChar(100)
  title                String?  @db.VarChar(100)
  company              String   @db.VarChar(200)
  email                String?  @db.VarChar(100)
  secondaryEmail       String?  @db.VarChar(100)
  phone                String?  @db.VarChar(30)
  mobile               String?  @db.VarChar(30)
  fax                  String?  @db.VarChar(30)
  website              String?  @db.VarChar(200)
  leadSource           String?  @db.VarChar(100)
  leadStatus           String?  @db.VarChar(100)
  industry             String?  @db.VarChar(100)
  annualRevenue        Decimal? @db.Decimal(16, 2)
  noOfEmployees        Int?
  rating               String?  @db.VarChar(10)
  emailOptOut          Boolean  @default(false)
  interest             String?  @db.VarChar(200)
  leadScore            Int?
  nextFollowUp         DateTime?
  isConverted          Boolean  @default(false)
  convertedAccountId   String?
  convertedContactId   String?
  convertedPotentialId String?
  description          String?  @db.Text
  companyId            String?
  isActive             Boolean  @default(true)
  assignedTo           String?
  street               String?  @db.VarChar(200)
  city                 String?  @db.VarChar(100)
  state                String?  @db.VarChar(100)
  country              String?  @db.VarChar(100)
  postalCode           String?  @db.VarChar(30)
  poBox                String?  @db.VarChar(50)
  createdBy            String?
  campaignId           String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model Potential {
  id               String    @id @default(uuid())
  potentialNo      String?   @unique @db.VarChar(100)
  potentialName    String    @db.VarChar(200)
  amount           Decimal?  @db.Decimal(16, 2)
  closingDate      DateTime?
  currency         String?   @db.VarChar(3)
  type             String?   @db.VarChar(100)
  stage            String?   @db.VarChar(100)
  probability      Int?
  leadSource       String?   @db.VarChar(100)
  forecastAmount   Decimal?  @db.Decimal(16, 2)
  forecastCategory String?   @db.VarChar(100)
  outcomeAnalysis  String?   @db.VarChar(500)
  nextStep         String?   @db.VarChar(500)
  description      String?   @db.Text
  companyId        String?
  isActive         Boolean   @default(true)
  assignedTo       String?
  campaignId       String?
  accountId        String?
  contactId        String?
  productId        String?
  createdBy        String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  lossReason     String?   @db.VarChar(500)
  nextFollowUp   DateTime?
  sourceCampaign String?   @db.VarChar(100)
  contactRole    String?   @db.VarChar(100)
  decisionMaker  Boolean   @default(false)

  products     PotentialProduct[]
  stageHistory PotentialStageHistory[]
  competitors  PotentialCompetitor[]
}

model PotentialProduct {
  id          String   @id @default(uuid())
  potentialId String
  productId   String
  qty         Decimal? @default(1) @db.Decimal(16, 2)
  listPrice   Decimal? @db.Decimal(16, 2)
  companyId   String?
  createdBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  potential Potential @relation(fields: [potentialId], references: [id])
  product   Product   @relation(fields: [productId], references: [id])

  @@unique([potentialId, productId])
  @@index([potentialId])
  @@index([productId])
  @@index([companyId])
}

model PotentialStageHistory {
  id          String   @id @default(uuid())
  potentialId String
  stage       String   @db.VarChar(100)
  changedBy   String?
  companyId   String?
  createdAt   DateTime @default(now())

  changedByUser User?     @relation("PotentialStageHistoryChangedBy", fields: [changedBy], references: [id])
  potential     Potential @relation(fields: [potentialId], references: [id])

  @@index([potentialId])
  @@index([companyId])
}

model Campaign {
  id                    String    @id @default(uuid())
  campaignNo            String?   @unique @db.VarChar(100)
  campaignName          String    @db.VarChar(200)
  campaignType          String?   @db.VarChar(100)
  status                String?   @db.VarChar(100)
  startDate             DateTime?
  endDate               DateTime?
  closingDate           DateTime?
  expectedRevenue       Decimal?  @db.Decimal(16, 2)
  budget                Decimal?  @db.Decimal(16, 2)
  actualCost            Decimal?  @db.Decimal(16, 2)
  expectedResponse      Int?
  targetSize            Int?
  sponsor               String?   @db.VarChar(200)
  targetAudience        String?   @db.VarChar(500)
  expectedROI           Decimal?  @db.Decimal(10, 2)
  actualROI             Decimal?  @db.Decimal(10, 2)
  expectedResponseCount Int?
  expectedSalesCount    Int?
  actualResponseCount   Int?
  actualSalesCount      Int?
  description           String?   @db.Text
  companyId             String?
  isActive              Boolean   @default(true)
  assignedTo            String?
  createdBy             String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
}

model Product {
  id                   String    @id @default(uuid())
  productNo            String?   @unique @db.VarChar(100)
  productName          String    @db.VarChar(200)
  partNumber           String?   @db.VarChar(100)
  productCategory      String?   @db.VarChar(100)
  productType          String?   @default("") @db.VarChar(100)
  manufacturer         String?   @db.VarChar(100)
  website              String?   @db.VarChar(200)
  unitPrice            Decimal?  @db.Decimal(16, 2)
  costPrice            Decimal?  @db.Decimal(16, 2)
  commissionRate       Decimal?  @db.Decimal(5, 2)
  commissionPercentage Decimal?  @db.Decimal(5, 2)
  commissionMethod     String?   @db.VarChar(50)
  weight               Decimal?  @db.Decimal(10, 2)
  packSize             Int?
  qtyInStock           Decimal?  @default(0) @db.Decimal(12, 2)
  qtyOnOrder           Decimal?  @default(0) @db.Decimal(12, 2)
  qtyInDemand          Decimal?  @default(0) @db.Decimal(12, 2)
  reorderLevel         Int?
  qtyPerUnit           String?   @db.VarChar(50)
  usageUnit            String?   @db.VarChar(50)
  salesStartDate       DateTime?
  salesEndDate         DateTime?
  startDate            DateTime?
  expiryDate           DateTime?
  supportStartDate     DateTime?
  supportEndDate       DateTime?
  discontinued         Boolean   @default(false)
  vat                  Boolean   @default(false)
  isService            Boolean   @default(false)
  isSales              Boolean   @default(false)
  vatPercentage        Decimal?  @db.Decimal(5, 2)
  servicePercentage    Decimal?  @db.Decimal(5, 2)
  salesPercentage      Decimal?  @db.Decimal(5, 2)
  pricingFormula       String?   @db.VarChar(50)
  markupPercent        Decimal?  @db.Decimal(5, 2)
  serialNo             String?   @db.VarChar(100)
  mfrPartNo            String?   @db.VarChar(100)
  vendorPartNo         String?   @db.VarChar(100)
  productSheet         String?   @db.VarChar(500)
  glAccount            String?   @db.VarChar(100)
  taxClass             String?   @db.VarChar(100)
  description          String?   @db.Text
  companyId            String?
  isActive             Boolean   @default(true)
  isDeleted            Boolean   @default(false)
  image                String?   @db.VarChar(500)
  vendorId             String?
  assignedTo           String?
  createdBy            String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  minimumOrderQty    Decimal? @default(1) @db.Decimal(12, 2)
  maximumOrderQty    Decimal? @db.Decimal(12, 2)
  qtyDiscountEnabled Boolean  @default(false)
  hsnCode            String?  @db.VarChar(20)
  sacCode            String?  @db.VarChar(20)
  warrantyMonths     Int?

  images ProductImage[]

  priceBookProducts PriceBookProduct[]
  potentialProducts PotentialProduct[]
}

model ProductImage {
  id        String   @id @default(uuid())
  productId String
  imageUrl  String   @db.VarChar(1000)
  isDefault Boolean  @default(false)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model LeadProduct {
  id        String   @id @default(uuid())
  leadId    String
  productId String
  qty       Decimal? @default(1) @db.Decimal(16, 2)
  listPrice Decimal? @db.Decimal(16, 2)
  companyId String?
  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([leadId, productId])
  @@index([leadId])
  @@index([productId])
  @@index([companyId])
}

model LeadService {
  id        String   @id @default(uuid())
  leadId    String
  serviceId String
  qty       Decimal? @default(1) @db.Decimal(16, 2)
  listPrice Decimal? @db.Decimal(16, 2)
  companyId String?
  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([leadId, serviceId])
  @@index([leadId])
  @@index([serviceId])
  @@index([companyId])
}

model Service {
  id               String   @id @default(uuid())
  serviceNo        String?  @unique @db.VarChar(100)
  serviceName      String   @db.VarChar(200)
  serviceCategory  String?  @db.VarChar(100)
  unitPrice        Decimal? @db.Decimal(16, 2)
  costPrice        Decimal? @db.Decimal(16, 2)
  commissionRate   Decimal? @db.Decimal(5, 2)
  commissionMethod String?  @db.VarChar(50)
  qtyPerUnit       String?  @db.VarChar(50)
  usageUnit        String?  @db.VarChar(50)
  taxClass         String?  @db.VarChar(100)
  reorderLevel     Int?
  qtyInStock       Decimal? @default(0) @db.Decimal(12, 2)
  qtyInDemand      Decimal? @default(0) @db.Decimal(12, 2)
  website          String?  @db.VarChar(200)
  serialNo         String?  @db.VarChar(100)
  glAccount        String?  @db.VarChar(100)
  discontinued     Boolean  @default(false)
  image            String?  @db.VarChar(500)
  description      String?  @db.Text
  vendorId         String?
  companyId        String?
  isActive         Boolean  @default(true)
  isDeleted        Boolean  @default(false)
  assignedTo       String?
  createdBy        String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  status             String?  @default("Active") @db.VarChar(50)
  billingCycle       String?  @db.VarChar(50)
  slaResponseHours   Int?
  slaResolutionHours Int?
  setupFee           Decimal? @db.Decimal(16, 2)
  minContractMonths  Int?
  trialAvailable     Boolean  @default(false)
  version            String?  @db.VarChar(50)
}

model Vendor {
  id          String   @id @default(uuid())
  vendorNo    String?  @unique @db.VarChar(100)
  vendorName  String   @db.VarChar(200)
  email       String?  @db.VarChar(100)
  phone       String?  @db.VarChar(30)
  mobile      String?  @db.VarChar(30)
  website     String?  @db.VarChar(200)
  category    String?  @db.VarChar(100)
  glAccount   String?  @db.VarChar(100)
  street      String?  @db.VarChar(200)
  city        String?  @db.VarChar(100)
  state       String?  @db.VarChar(100)
  country     String?  @db.VarChar(100)
  postalCode  String?  @db.VarChar(30)
  description String?  @db.Text
  companyId   String?
  isActive    Boolean  @default(true)
  assignedTo  String?
  createdBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  rating          String?  @db.VarChar(10)
  taxId           String?  @db.VarChar(100)
  paymentTerms    String?  @db.VarChar(100)
  annualRevenue   Decimal? @db.Decimal(16, 2)
  employees       Int?
  yearEstablished Int?
  logo            String?  @db.VarChar(500)
  linkedin        String?  @db.VarChar(500)
  contactPerson   String?  @db.VarChar(200)
  contactEmail    String?  @db.VarChar(100)
  contactPhone    String?  @db.VarChar(30)
}

model PriceBook {
  id            String   @id @default(uuid())
  priceBookNo   String?  @unique @db.VarChar(100)
  priceBookName String   @db.VarChar(200)
  active        Boolean  @default(true)
  companyId     String?
  isActive      Boolean  @default(true)
  description   String?  @db.Text
  assignedTo    String?
  createdBy     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  currency           String?   @default("USD") @db.VarChar(3)
  conversionRate     Decimal   @default(1) @db.Decimal(10, 5)
  discountAllowed    Boolean   @default(false)
  maxDiscountPercent Decimal?  @db.Decimal(5, 2)
  validFrom          DateTime?
  validUntil         DateTime?
  targetSegment      String?   @db.VarChar(100)

  products PriceBookProduct[]
}

model PriceBookProduct {
  id          String    @id @default(uuid())
  priceBookId String
  priceBook   PriceBook @relation(fields: [priceBookId], references: [id])
  productId   String
  product     Product   @relation(fields: [productId], references: [id])
  listPrice   Decimal   @db.Decimal(16, 2)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([priceBookId, productId])
}

model Quote {
