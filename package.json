{
  "name": "bizforce-crm",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --parallel",
    "dev:backend": "npm run dev -w packages/backend",
    "dev:frontend": "npm run dev -w packages/frontend-next",
    "build": "npm run build --workspaces",
    "lint": "npm run lint --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "test": "npm run test --workspace @bizforce/backend",
    "db:migrate": "npm run db:migrate -w packages/backend",
    "db:seed": "npm run db:seed -w packages/backend",
    "db:studio": "npm run db:studio -w packages/backend"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "devDependencies": {
    "@isomorphic-git/lightning-fs": "^4.7.0",
    "isomorphic-git": "^1.40.0"
  }
}
